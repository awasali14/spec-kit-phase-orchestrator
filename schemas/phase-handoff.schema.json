{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/awasali14/spec-kit-phase-orchestrator/schemas/phase-handoff.schema.json",
  "title": "Spec Kit Phase Stage Handoff",
  "description": "Compact context passed to one isolated stage agent in the Phase Orchestrator 2.0 workflow.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage",
    "tasks_path",
    "phase",
    "assigned_task_ids",
    "prior",
    "expected_failures",
    "scope",
    "validation",
    "report_contract"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "stage": {
      "enum": ["baseline_verification", "test", "implementation", "verification", "remediation", "documentation"]
    },
    "tasks_path": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "title",
        "slug"
      ],
      "properties": {
        "number": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1},
        "slug": {"type": "string", "minLength": 1},
        "purpose": {"type": ["string", "null"]},
        "checkpoint": {"type": ["string", "null"]},
        "independent_test": {"type": ["string", "null"]}
      }
    },
    "assigned_task_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^T[0-9]+$"},
      "uniqueItems": true
    },
    "prior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit_sha", "manifest", "validation"],
      "properties": {
        "commit_sha": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{7,64}$"
        },
        "manifest": {
          "type": "array",
          "items": {"$ref": "#/$defs/manifest_entry"}
        },
        "validation": {
          "type": "array",
          "items": {"$ref": "#/$defs/validation_result"}
        }
      }
    },
    "regression_baseline": {
      "type": "array",
      "items": {"$ref": "#/$defs/comparison_evidence"}
    },
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    },
    "expected_failures": {
      "type": "array",
      "items": {"$ref": "#/$defs/expected_failure"}
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase_number",
        "relevant_paths",
        "protected_paths",
        "read_only",
        "forbidden_actions"
      ],
      "properties": {
        "phase_number": {"type": "integer", "minimum": 1},
        "relevant_paths": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "protected_paths": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "read_only": {"type": "boolean"},
        "forbidden_actions": {
          "type": "array",
          "items": {
            "enum": ["stage", "commit", "push", "spawn", "run_orchestrator", "cross_phase"]
          },
          "minItems": 6,
          "uniqueItems": true
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectations"],
      "properties": {
        "expectations": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "report_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "schema_version", "stage"],
      "properties": {
        "schema_id": {
          "const": "https://github.com/awasali14/spec-kit-phase-orchestrator/schemas/phase-report.schema.json"
        },
        "schema_version": {"const": "2.0.0"},
        "stage": {
          "enum": ["baseline_verification", "test", "implementation", "verification", "remediation", "documentation"]
        }
      }
    },
    "documentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "workflow_complete_marker", "mermaid_required"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "workflow_complete_marker": {
          "const": "<!-- phase-orchestrator:workflow-complete v2 -->"
        },
        "mermaid_required": {"type": "boolean"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"stage": {"const": "baseline_verification"}}},
      "then": {"properties": {"report_contract": {"properties": {"stage": {"const": "baseline_verification"}}}}}
    },
    {
      "if": {"properties": {"stage": {"const": "test"}}},
      "then": {"properties": {"report_contract": {"properties": {"stage": {"const": "test"}}}}}
    },
    {
      "if": {"properties": {"stage": {"const": "implementation"}}},
      "then": {"properties": {"report_contract": {"properties": {"stage": {"const": "implementation"}}}}}
    },
    {
      "if": {"properties": {"stage": {"const": "verification"}}},
      "then": {"properties": {"report_contract": {"properties": {"stage": {"const": "verification"}}}}}
    },
    {
      "if": {"properties": {"stage": {"const": "remediation"}}},
      "then": {"properties": {"report_contract": {"properties": {"stage": {"const": "remediation"}}}}}
    },
    {
      "if": {"properties": {"stage": {"const": "documentation"}}},
      "then": {"properties": {"report_contract": {"properties": {"stage": {"const": "documentation"}}}}}
    },
    {
      "if": {"properties": {"stage": {"const": "baseline_verification"}}},
      "then": {
        "properties": {
          "assigned_task_ids": {"maxItems": 0},
          "scope": {"properties": {"read_only": {"const": true}}}
        }
      }
    },
    {
      "if": {"properties": {"stage": {"enum": ["test", "implementation"]}}},
      "then": {"properties": {"assigned_task_ids": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"stage": {"const": "verification"}}},
      "then": {
        "properties": {
          "scope": {"properties": {"read_only": {"const": true}}}
        }
      },
      "else": {
        "properties": {
          "findings": {
            "items": {
              "properties": {
                "disposition": {"enum": ["remediate", "defer", "block"]}
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"stage": {"const": "remediation"}}},
      "then": {
        "properties": {
          "scope": {"properties": {"read_only": {"const": false}}}
        }
      }
    },
    {
      "if": {"properties": {"stage": {"const": "documentation"}}},
      "then": {
        "required": ["documentation"],
        "properties": {
          "scope": {"properties": {"read_only": {"const": false}}}
        }
      },
      "else": {
        "not": {"required": ["documentation"]}
      }
    }
  ],
  "$defs": {
    "comparison_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "environment_fingerprint",
        "status",
        "failing_tests",
        "failure_signatures"
      ],
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "environment_fingerprint": {"type": "string", "minLength": 1},
        "status": {"enum": ["passed", "failed", "not_run"]},
        "failing_tests": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "failure_signatures": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "gate",
        "disposition",
        "attribution",
        "confidence",
        "summary",
        "related_task_ids",
        "affected_paths",
        "baseline_evidence",
        "current_evidence",
        "downstream_safe"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {
          "enum": [
            "defective_test",
            "phase_scoped_failure",
            "phase_introduced_regression",
            "preexisting_unrelated_regression",
            "cross_phase_dependency",
            "inconclusive"
          ]
        },
        "gate": {"enum": ["focused", "independent_phase", "regression", "scope"]},
        "disposition": {"enum": [null, "remediate", "defer", "block"]},
        "attribution": {
          "enum": [
            "phase_introduced",
            "preexisting_unrelated",
            "uncertain",
            "not_applicable"
          ]
        },
        "confidence": {"enum": ["confirmed", "uncertain"]},
        "summary": {"type": "string", "minLength": 1},
        "related_task_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "^T[0-9]+$"},
          "uniqueItems": true
        },
        "affected_paths": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "baseline_evidence": {
          "oneOf": [
            {"$ref": "#/$defs/comparison_evidence"},
            {"type": "null"}
          ]
        },
        "current_evidence": {
          "oneOf": [
            {"$ref": "#/$defs/comparison_evidence"},
            {"type": "null"}
          ]
        },
        "downstream_safe": {"type": ["boolean", "null"]}
      }
    },
    "manifest_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "status"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "status": {"enum": ["added", "modified", "deleted", "renamed"]}
      }
    },
    "validation_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "command", "status", "summary"],
      "properties": {
        "kind": {"enum": ["focused", "independent_phase", "regression"]},
        "command": {"type": "string", "minLength": 1},
        "status": {"enum": ["passed", "failed", "not_run", "expected_red"]},
        "summary": {"type": "string", "minLength": 1}
      }
    },
    "expected_failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "related_task_ids", "attributable_to_missing_implementation"],
      "properties": {
        "summary": {"type": "string", "minLength": 1},
        "related_task_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "^T[0-9]+$"},
          "minItems": 1,
          "uniqueItems": true
        },
        "attributable_to_missing_implementation": {"const": true}
      }
    }
  }
}
