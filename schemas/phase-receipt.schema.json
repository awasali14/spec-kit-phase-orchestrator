{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/awasali14/spec-kit-phase-orchestrator/schemas/phase-receipt.schema.json",
  "title": "Spec Kit Phase Receipt",
  "description": "Result reported after one phase-scoped Spec Kit implementation run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "phase",
    "completed_task_ids",
    "changed_files",
    "validation",
    "documentation_path",
    "receipt_path",
    "issues"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "status": {
      "type": "string",
      "enum": ["completed", "blocked", "failed"]
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "title"],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "completed_task_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^T[0-9]+$"
      },
      "uniqueItems": true
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validation": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "status"],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": ["passed", "failed", "not_run"]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "documentation_path": {
      "type": "string",
      "minLength": 1
    },
    "receipt_path": {
      "type": "string",
      "minLength": 1
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commit": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "hash": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        }
      }
    }
  }
}
